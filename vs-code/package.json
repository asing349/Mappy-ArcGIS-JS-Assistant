{
  "name": "mappy-js-sdk",
  "displayName": "Mappy - ArcGIS JS SDK Docs",
  "description": "AI-powered documentation assistant for ArcGIS JavaScript SDK. Get instant answers, code examples, and context-aware help.",
  "version": "0.5.3",
  "publisher": "ajitsingh",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/asing349/Mappy-ArcGIS-JS-Assistant"
  },
  "homepage": "https://mappy-js-sdk.vercel.app",
  "bugs": {
    "url": "https://github.com/asing349/Mappy-ArcGIS-JS-Assistant/issues"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "arcgis",
    "esri",
    "javascript",
    "documentation",
    "ai",
    "assistant",
    "sdk",
    "maps",
    "gis",
    "docs",
    "code-examples",
    "developer-tools"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:html"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mappy.openChat",
        "title": "Open Chat",
        "category": "Mappy",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "mappy.askQuestion",
        "title": "Ask Question",
        "category": "Mappy"
      },
      {
        "command": "mappy.askAboutSymbol",
        "title": "Ask Mappy About This",
        "category": "Mappy"
      },
      {
        "command": "mappy.clearCache",
        "title": "Clear Cache",
        "category": "Mappy"
      },
      {
        "command": "mappy.testConnection",
        "title": "Test API Connection",
        "category": "Mappy"
      },
      {
        "command": "mappy.resetChat",
        "title": "Reset Chat Panel",
        "category": "Mappy"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "mappy.askAboutSymbol",
          "when": "editorTextFocus && (resourceLangId == javascript || resourceLangId == typescript || resourceLangId == javascriptreact || resourceLangId == typescriptreact)",
          "group": "mappy@1"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mappy-sidebar",
          "title": "Mappy Assistant",
          "icon": "media/icon.png"
        }
      ]
    },
    "views": {
      "mappy-sidebar": [
        {
          "type": "webview",
          "id": "mappy.chatView",
          "name": "Chat"
        }
      ]
    },
    "configuration": {
      "title": "Mappy Assistant",
      "properties": {
        "mappy.apiUrl": {
          "type": "string",
          "default": "https://mappy-arcgis-js-assistant-production.up.railway.app",
          "description": "Mappy API URL (default is official hosted instance)",
          "order": 1
        },
        "mappy.enableChat": {
          "type": "boolean",
          "default": true,
          "description": "Enable chat sidebar",
          "order": 2
        },
        "mappy.cacheTimeout": {
          "type": "number",
          "default": 300,
          "description": "Cache timeout in seconds (default: 5 minutes)",
          "order": 3
        },
        "mappy.sdkVersion": {
          "type": "string",
          "default": "4.34",
          "description": "ArcGIS JavaScript SDK version",
          "order": 4
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "lint": "eslint src --ext ts",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.x",
    "@typescript-eslint/parser": "^6.x",
    "eslint": "^8.x",
    "typescript": "^5.3.0",
    "@vscode/vsce": "^2.22.0"
  },
  "dependencies": {
    "axios": "^1.6.0"
  }
}
