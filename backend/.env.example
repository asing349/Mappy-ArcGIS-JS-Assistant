# API Keys
OPENAI_API_KEY=your_openai_api_key_here

# Embedding Model Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu  # or cuda if available

# Chunking Configuration
DEFAULT_CHUNK_SIZE=800
CHUNK_OVERLAP_PERCENTAGE=15
MAX_CHUNK_SIZE=1200

# Vector Database
CHROMA_PERSIST_DIRECTORY=./data/embeddings
CHROMA_COLLECTION_NAME=mappy-arcgis-docs

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/mappy.log

# Development
DEBUG=False
